# --- Required ---
BOT_TOKEN=123456:your-telegram-bot-token-here
# Secret for signing panel sessions (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the web panel, used for /app login links, e.g. https://expenses.example.com
PUBLIC_URL=http://localhost:3000

# --- Optional ---
# Bot display name shown in links (default: Expense Tracker)
BOT_USERNAME=your_bot_username
PORT=3000
# Directory for sqlite file (default: ./data)
DATA_DIR=./data
# Base currency for totals. Totals are stored converted to this currency.
BASE_CURRENCY=TJS
# Default currency when user writes no currency symbol/code
DEFAULT_CURRENCY=TJS
# Exchange rates to BASE currency, JSON. Used for multi-currency totals.
# Example for Tajikistan: 1 USD ~ 10.9 TJS, 1 EUR ~ 11.8, 1 RUB ~ 0.12
RATES_JSON={"USD":10.9,"EUR":11.8,"RUB":0.12,"TJS":1}
# Bot mode: polling (default, easiest) or webhook
BOT_MODE=polling
# For webhook mode: public https url Telegram will call + secret path
WEBHOOK_URL=
WEBHOOK_PATH=/tg-webhook/secret-path
# OCR of receipt photos: off | caption (default) | tesseract
# caption = parse amount from photo caption only (no heavy deps)
# tesseract = try OCR via tesseract.js (needs optional dep + lang data)
OCR_MODE=caption
